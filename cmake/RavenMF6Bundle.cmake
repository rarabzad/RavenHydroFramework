# RavenMF6Bundle.cmake: install time. Puts the Fortran runtime libraries the MODFLOW 6 library needs (a library built
# from source with gfortran needs libgfortran) into the install's bin folder beside Raven and libmf6, so that the
# installed folder runs on a computer without a Fortran compiler. Official release libraries need none.
#
# Included from cmake_install.cmake (install(CODE)) with
#   RAVEN_MF6_BUNDLE_LIB     the library in the build tree (its dependencies are read from it, not from the installed copy)
#   RAVEN_MF6_BUNDLE_FC      the Fortran compiler of a source build (Windows: its folder holds the runtime DLLs), or empty
#   RAVEN_MF6_BUNDLE_SYSTEM  CMAKE_SYSTEM_NAME
#   RAVEN_MF6_BUNDLE_NAME    libmf6.so / libmf6.dylib / libmf6.dll
#   RAVEN_MF6_PATCHELF       (optional, Linux) the patchelf program; found on the PATH when not given
# The files go through file(INSTALL ... DESTINATION ${CMAKE_INSTALL_PREFIX}/bin), which prefixes $ENV{DESTDIR} exactly as
# for Raven's own files (staged installs, also with a relative DESTDIR, get the runtime too). Anything
# that cannot be resolved is reported with a warning, never skipped silently.
cmake_policy(VERSION 3.20)                         # (cmake_install.cmake sets no policies; include() scopes this)
set(_dest "${CMAKE_INSTALL_PREFIX}/bin")
set(_lib "${RAVEN_MF6_BUNDLE_LIB}")
if(NOT EXISTS "${_lib}")
  message(WARNING "MODFLOW 6 runtime bundling: ${_lib} not found (build first); the Fortran runtime is not installed")
  return()
endif()
set(_runtime_re "^(lib)?(gfortran|quadmath|ifcore|ifcoremd|ifport|ifportmd|imf|svml|intlc|irng|libmmd|libifcoremd|libifportmd|libmmd|svml_dispmd)")
set(_found "")

if(RAVEN_MF6_BUNDLE_SYSTEM STREQUAL "Linux" OR RAVEN_MF6_BUNDLE_SYSTEM STREQUAL "FreeBSD")
  find_program(_ldd ldd)
  if(NOT _ldd)
    message(WARNING "MODFLOW 6 runtime bundling: ldd not found; cannot tell which Fortran runtime ${_lib} needs")
    return()
  endif()
  execute_process(COMMAND "${_ldd}" "${_lib}" OUTPUT_VARIABLE _out ERROR_VARIABLE _err RESULT_VARIABLE _r)
  string(REPLACE "\n" ";" _lines "${_out}")
  foreach(_l IN LISTS _lines)
    if(_l MATCHES "^[ \t]*([^ \t]+)[ \t]+=>[ \t]+(.*)$")
      set(_n "${CMAKE_MATCH_1}")
      set(_p "${CMAKE_MATCH_2}")
      if(_n MATCHES "${_runtime_re}")
        if(_p MATCHES "^not found" OR NOT _p MATCHES "^(/[^ ]+)")
          message(WARNING "MODFLOW 6 runtime bundling: ${_n}, needed by ${_lib}, was not found by ldd; it is not installed")
        else()
          get_filename_component(_real "${CMAKE_MATCH_1}" REALPATH)
          list(APPEND _found "${_n}|${_real}")
        endif()
      endif()
    endif()
  endforeach()
elseif(RAVEN_MF6_BUNDLE_SYSTEM STREQUAL "Darwin")
  # every runtime library the library needs, directly or through another runtime library (libgfortran.5.dylib needs
  # libquadmath.0.dylib and libgcc_s.1.1.dylib), with @rpath and @loader_path references resolved against the LC_RPATH
  # entries of the referencing binary and of libmf6 (Homebrew's gcc links through @rpath)
  if(NOT RAVEN_MF6_OTOOL)
    find_program(RAVEN_MF6_OTOOL NAMES otool llvm-otool)
  endif()
  if(NOT RAVEN_MF6_INSTALL_NAME_TOOL)
    find_program(RAVEN_MF6_INSTALL_NAME_TOOL NAMES install_name_tool llvm-install-name-tool)
  endif()
  set(_otool "${RAVEN_MF6_OTOOL}")
  set(_int "${RAVEN_MF6_INSTALL_NAME_TOOL}")
  if(NOT _otool OR NOT _int)
    message(WARNING "MODFLOW 6 runtime bundling: otool/install_name_tool not found; the Fortran runtime is not installed")
    return()
  endif()
  set(_darwin_re "${_runtime_re}|^libgcc_s")
  # LC_RPATH entries of a binary, @loader_path expanded to its folder
  function(_rmf6_rpaths bin out)
    execute_process(COMMAND "${_otool}" -l "${bin}" OUTPUT_VARIABLE _o ERROR_QUIET)
    string(REPLACE "\n" ";" _ls "${_o}")
    get_filename_component(_bd "${bin}" DIRECTORY)
    set(_rp "")
    set(_in FALSE)
    foreach(_x IN LISTS _ls)
      if(_x MATCHES "^[ \t]*cmd[ \t]+LC_RPATH")
        set(_in TRUE)
      elseif(_in AND _x MATCHES "^[ \t]*path[ \t]+(.+) \\(offset [0-9]+\\)")
        string(REPLACE "@loader_path" "${_bd}" _p "${CMAKE_MATCH_1}")
        list(APPEND _rp "${_p}")
        set(_in FALSE)
      elseif(_x MATCHES "^[ \t]*cmd[ \t]")
        set(_in FALSE)
      endif()
    endforeach()
    set(${out} "${_rp}" PARENT_SCOPE)
  endfunction()
  _rmf6_rpaths("${_lib}" _lib_rpaths)
  set(_queue "${_lib}|${RAVEN_MF6_BUNDLE_NAME}")      # (binary in the build/compiler tree | its name in the install)
  set(_done "")
  while(_queue)
    list(POP_FRONT _queue _q)
    string(REPLACE "|" ";" _q "${_q}")
    list(GET _q 0 _bin)
    list(GET _q 1 _binname)
    execute_process(COMMAND "${_otool}" -D "${_bin}" OUTPUT_VARIABLE _ido ERROR_QUIET)
    string(REPLACE "\n" ";" _idl "${_ido}")
    list(LENGTH _idl _nid)
    set(_id "")
    if(_nid GREATER 1)
      list(GET _idl 1 _id)
      string(STRIP "${_id}" _id)
    endif()
    _rmf6_rpaths("${_bin}" _rp)
    list(APPEND _rp ${_lib_rpaths})
    get_filename_component(_bd "${_bin}" DIRECTORY)
    execute_process(COMMAND "${_otool}" -L "${_bin}" OUTPUT_VARIABLE _out ERROR_QUIET)
    string(REPLACE "\n" ";" _lines "${_out}")
    foreach(_l IN LISTS _lines)
      if(NOT _l MATCHES "^[ \t]+([^ \t]+) \\(")
        continue()
      endif()
      set(_p "${CMAKE_MATCH_1}")
      get_filename_component(_n "${_p}" NAME)
      if(_p STREQUAL _id OR NOT _n MATCHES "${_darwin_re}" OR _p MATCHES "^(/usr/lib/|/System/)")
        continue()                                 # (its own install name; not a runtime library; a system library)
      endif()
      set(_real "")
      if(_p MATCHES "^@rpath/(.*)$")
        set(_rest "${CMAKE_MATCH_1}")
        foreach(_d IN LISTS _rp)
          if(NOT _real AND NOT _d MATCHES "^@" AND EXISTS "${_d}/${_rest}")
            set(_real "${_d}/${_rest}")
          endif()
        endforeach()
      elseif(_p MATCHES "^@loader_path/(.*)$")
        if(EXISTS "${_bd}/${CMAKE_MATCH_1}")
          set(_real "${_bd}/${CMAKE_MATCH_1}")
        endif()
      elseif(EXISTS "${_p}")
        set(_real "${_p}")
      endif()
      if(NOT _real)
        message(WARNING "MODFLOW 6 runtime bundling: ${_p}, needed by ${_bin}, was not found (LC_RPATH: ${_rp}); it is not "
                        "installed, and the installed folder needs it on the computer it runs on")
        continue()
      endif()
      get_filename_component(_real "${_real}" REALPATH)
      list(APPEND _found "${_n}|${_real}|${_p}|${_binname}")
      if(NOT _n IN_LIST _done)
        list(APPEND _done "${_n}")
        list(APPEND _queue "${_real}|${_n}")
      endif()
    endforeach()
  endwhile()
elseif(RAVEN_MF6_BUNDLE_SYSTEM STREQUAL "Windows")
  find_program(_objdump objdump)
  find_program(_dumpbin dumpbin)                   # (MSVC environments have no objdump)
  # the runtime DLLs a binary imports (objdump -p, else dumpbin /dependents)
  function(_rmf6_win_imports bin out)
    set(_imp "")
    if(_objdump)
      execute_process(COMMAND "${_objdump}" -p "${bin}" OUTPUT_VARIABLE _o ERROR_QUIET)
      string(REGEX MATCHALL "DLL Name: [^\r\n]+" _imp "${_o}")
    else()
      execute_process(COMMAND "${_dumpbin}" /nologo /dependents "${bin}" OUTPUT_VARIABLE _o ERROR_QUIET)
      string(REGEX MATCHALL "\n[ \t]+[A-Za-z0-9_.+-]+\\.[dD][lL][lL][ \t\r]*" _imp "${_o}")
    endif()
    set(_c "")
    foreach(_i IN LISTS _imp)
      string(STRIP "${_i}" _i)
      string(REGEX REPLACE "^DLL Name: " "" _i "${_i}")
      string(STRIP "${_i}" _i)
      if(_i MATCHES "^lib(gfortran|quadmath|gcc_s|winpthread)" OR _i MATCHES "${_runtime_re}")
        list(APPEND _c "${_i}")
      endif()
    endforeach()
    set(${out} "${_c}" PARENT_SCOPE)
  endfunction()
  set(_dirs "")
  if(RAVEN_MF6_BUNDLE_FC)
    get_filename_component(_fcdir "${RAVEN_MF6_BUNDLE_FC}" DIRECTORY)
    list(APPEND _dirs "${_fcdir}")
  endif()
  if(_objdump OR _dumpbin)                         # what the library imports, and what those DLLs import in turn
    set(_queue "${_lib}")                          # (libgfortran-5.dll needs libquadmath-0.dll, libgcc_s_seh-1.dll, ...)
    set(_done "")
    while(_queue)
      list(POP_FRONT _queue _bin)
      _rmf6_win_imports("${_bin}" _cands)
      foreach(_c IN LISTS _cands)
        if(_c IN_LIST _done)
          continue()
        endif()
        list(APPEND _done "${_c}")
        unset(_RMF6_DLL CACHE)
        unset(_RMF6_DLL)
        find_file(_RMF6_DLL NAMES "${_c}" HINTS ${_dirs})
        if(_RMF6_DLL)
          list(APPEND _found "${_c}|${_RMF6_DLL}")
          list(APPEND _queue "${_RMF6_DLL}")
        else()
          message(WARNING "MODFLOW 6 runtime bundling: ${_c}, imported by ${_bin}, was not found; it is not installed")
        endif()
      endforeach()
    endwhile()
  else()                                           # no tool to read the imports: the usual gfortran runtime DLLs, if found
    message(WARNING "MODFLOW 6 runtime bundling: neither objdump nor dumpbin found; the usual gfortran runtime DLLs are "
                    "installed where found, without knowing whether ${_lib} needs them")
    foreach(_c IN ITEMS libgfortran-5.dll libquadmath-0.dll libgcc_s_seh-1.dll libwinpthread-1.dll)
      unset(_RMF6_DLL CACHE)
      unset(_RMF6_DLL)
      find_file(_RMF6_DLL NAMES "${_c}" HINTS ${_dirs})
      if(_RMF6_DLL)
        list(APPEND _found "${_c}|${_RMF6_DLL}")
      endif()
    endforeach()
  endif()
endif()

set(_copied "")
set(_inst "$ENV{DESTDIR}${_dest}")                 # (a relative DESTDIR: relative to the folder cmake --install runs in,
                                                   # which the tools below run in too)
foreach(_f IN LISTS _found)
  string(REPLACE "|" ";" _f "${_f}")
  list(GET _f 0 _n)
  list(GET _f 1 _real)
  set(_by "${RAVEN_MF6_BUNDLE_NAME}")
  list(LENGTH _f _nf)
  if(_nf GREATER 3)
    list(GET _f 3 _by)
  endif()
  if(NOT _n IN_LIST _copied)
    list(APPEND _copied "${_n}")
    message(STATUS "MODFLOW 6 runtime: ${_n} (needed by ${_by})")
    file(INSTALL DESTINATION "${_dest}" TYPE PROGRAM FILES "${_real}" RENAME "${_n}")
    if(RAVEN_MF6_BUNDLE_SYSTEM STREQUAL "Darwin")
      execute_process(COMMAND "${_int}" -id "@loader_path/${_n}" "${_inst}/${_n}" RESULT_VARIABLE _r ERROR_VARIABLE _e)
      if(NOT _r EQUAL 0)
        message(WARNING "MODFLOW 6 runtime bundling: install_name_tool -id on ${_inst}/${_n} failed: ${_e}")
      endif()
    endif()
  endif()
  if(RAVEN_MF6_BUNDLE_SYSTEM STREQUAL "Darwin")   # the referencing binary (libmf6 or a runtime library) -> the copy beside it
    list(GET _f 2 _ref)
    execute_process(COMMAND "${_int}" -change "${_ref}" "@loader_path/${_n}" "${_inst}/${_by}" RESULT_VARIABLE _r ERROR_VARIABLE _e)
    if(NOT _r EQUAL 0)
      message(WARNING "MODFLOW 6 runtime bundling: install_name_tool -change ${_ref} on ${_inst}/${_by} failed: ${_e}")
    endif()
  endif()
endforeach()
# Apple silicon loads no binary whose signature no longer matches: the edited ones are signed again (ad hoc, as the
# linker signs them); without codesign (not on a Mac) only a note
if(RAVEN_MF6_BUNDLE_SYSTEM STREQUAL "Darwin" AND _copied)
  if(NOT RAVEN_MF6_CODESIGN)
    find_program(RAVEN_MF6_CODESIGN codesign)
  endif()
  if(RAVEN_MF6_CODESIGN)
    foreach(_n IN LISTS _copied ITEMS "${RAVEN_MF6_BUNDLE_NAME}")
      execute_process(COMMAND "${RAVEN_MF6_CODESIGN}" -f -s - "${_inst}/${_n}" RESULT_VARIABLE _r ERROR_VARIABLE _e)
      if(NOT _r EQUAL 0)
        message(WARNING "MODFLOW 6 runtime bundling: codesign of ${_inst}/${_n} failed: ${_e}")
      endif()
    endforeach()
  else()
    message(WARNING "MODFLOW 6 runtime bundling: codesign not found; the edited libraries are not signed again (Apple "
                    "silicon may refuse to load them: codesign -f -s - <file>)")
  endif()
endif()
# Linux: the copied runtime libraries find each other beside libmf6 only with a run path $ORIGIN of their own (a copied
# libgfortran that needs libquadmath); patchelf sets it where available
if(NOT RAVEN_MF6_BUNDLE_SYSTEM STREQUAL "Darwin" AND NOT RAVEN_MF6_BUNDLE_SYSTEM STREQUAL "Windows")
  if(_copied AND NOT DEFINED RAVEN_MF6_PATCHELF)
    find_program(RAVEN_MF6_PATCHELF patchelf)
  endif()
  list(LENGTH _copied _nc)
  if(_nc GREATER 1)
    foreach(_n IN LISTS _copied)
      if(RAVEN_MF6_PATCHELF)
        execute_process(COMMAND "${RAVEN_MF6_PATCHELF}" --set-rpath "$ORIGIN" "${_inst}/${_n}" RESULT_VARIABLE _r)
      else()
        set(_r 1)
      endif()
      if(NOT _r EQUAL 0)
        message(WARNING "MODFLOW 6 runtime bundling: ${_n} has no run path $ORIGIN (patchelf not found): the runtime "
                        "libraries it needs beside it are found only through the system's library path")
      endif()
    endforeach()
  endif()
  # Raven loads libmf6 by its path, so Raven's own run path does not apply to libmf6's dependencies: the copied runtime
  # is used only when the installed libmf6 has the run path $ORIGIN (a libmf6 built by this CMake from source has it; one
  # built elsewhere and given with RAVEN_MF6_PATH may not). patchelf adds it where needed.
  set(_mf6inst "${_inst}/${RAVEN_MF6_BUNDLE_NAME}")
  if(_copied AND EXISTS "${_mf6inst}")
    set(_rp "")
    set(_rp_known FALSE)
    if(RAVEN_MF6_PATCHELF)
      execute_process(COMMAND "${RAVEN_MF6_PATCHELF}" --print-rpath "${_mf6inst}" OUTPUT_VARIABLE _rp
                      RESULT_VARIABLE _r OUTPUT_STRIP_TRAILING_WHITESPACE)
      if(_r EQUAL 0)
        set(_rp_known TRUE)
      endif()
    else()
      find_program(_readelf readelf)
      if(_readelf)
        execute_process(COMMAND "${_readelf}" -d "${_mf6inst}" OUTPUT_VARIABLE _d RESULT_VARIABLE _r ERROR_QUIET)
        if(_r EQUAL 0)
          set(_rp_known TRUE)
          if(_d MATCHES "\\((RPATH|RUNPATH)\\)[^[]*\\[([^]]*)\\]")
            set(_rp "${CMAKE_MATCH_2}")
          endif()
        endif()
      endif()
    endif()
    string(REPLACE ":" ";" _rpl "${_rp}")
    if(_rp_known AND ("$ORIGIN" IN_LIST _rpl OR "\${ORIGIN}" IN_LIST _rpl))
      message(STATUS "MODFLOW 6 runtime: ${RAVEN_MF6_BUNDLE_NAME} has the run path $ORIGIN")
    elseif(RAVEN_MF6_PATCHELF AND _rp_known)
      if(_rp STREQUAL "")
        set(_newrp "$ORIGIN")
      else()
        set(_newrp "$ORIGIN:${_rp}")
      endif()
      execute_process(COMMAND "${RAVEN_MF6_PATCHELF}" --set-rpath "${_newrp}" "${_mf6inst}" RESULT_VARIABLE _r ERROR_VARIABLE _e)
      if(_r EQUAL 0)
        message(STATUS "MODFLOW 6 runtime: run path $ORIGIN given to the installed ${RAVEN_MF6_BUNDLE_NAME} (patchelf), so "
                       "it loads the runtime beside it")
      else()
        message(WARNING "MODFLOW 6 runtime bundling: patchelf --set-rpath on ${_mf6inst} failed (${_e}): the installed "
                        "${RAVEN_MF6_BUNDLE_NAME} loads the Fortran runtime of the system, not the copy beside it")
      endif()
    else()
      string(REPLACE ";" ", " _cl "${_copied}")
      if(RAVEN_MF6_PATCHELF)
        set(_why "patchelf could not read its run path")
      else()
        set(_why "patchelf was not found")
      endif()
      message(WARNING "MODFLOW 6 runtime bundling: the installed ${RAVEN_MF6_BUNDLE_NAME} has no run path $ORIGIN and "
                      "${_why}, so it loads the system's ${_cl} (if any) instead of the copies beside it; "
                      "the folder then does not run on a computer without that runtime. Install patchelf and run "
                      "cmake --install again, or build libmf6 with the link option -Wl,-rpath,'$ORIGIN'.")
    endif()
  endif()
endif()
if(NOT _found)
  message(STATUS "MODFLOW 6 runtime: ${RAVEN_MF6_BUNDLE_NAME} needs no Fortran runtime library")
endif()
